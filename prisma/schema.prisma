// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql" // Assurez-vous que c'est postgresql
  url          = env("DATABASE_URL") // Lit depuis .env.local
  relationMode = "prisma" // Recommandé pour Neon/Serverless
}

// --- Modèles de données ---

model User {
  id          String     @id @default(cuid()) // Cuid() est un bon choix pour les ID uniques
  email       String     @unique
  username    String? // Le '?' indique que c'est optionnel (nullable)
  clerkId     String     @unique
  name        String?
  image       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  categories  Category[]
  expenses    Expense[]
  budgets     Budget[]
  memberships Membership[]

  @@map("users") // Nom de la table dans la base de données
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  color     String?   @default("#A7C5EB")
  isDefault Boolean   @default(false) @map("is_default")

  // Relation avec User (une catégorie peut appartenir à un utilisateur ou être par défaut)
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade) // onDelete: Cascade si l'utilisateur est supprimé

  // Relation avec d'autres modèles
  expenses    Expense[]
  budgets     Budget[]
  memberships Membership[]

  @@map("categories")
}

model Expense {
  id            String    @id @default(cuid())
  amount        Decimal   // Prisma gère Decimal pour les montants précis
  description   String?
  expenseDate   DateTime  @db.Date @map("expense_date") // @db.Date pour stocker seulement la date
  receiptImage  String?   @map("receipt_image")
  paymentMethod String?   @map("payment_method")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relation avec Category (une dépense a une catégorie optionnelle)
  categoryId    String?   @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // Si la catégorie est supprimée, met categoryId à NULL

  // Relation avec User (une dépense appartient à un utilisateur)
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade) // Si l'utilisateur est supprimé, ses dépenses aussi

  @@map("expenses")
}

model Budget {
  id         String   @id @default(cuid())
  name       String
  amount     Decimal
  period     Period   @default(monthly) // Utilisation de l'Enum Period
  startDate  DateTime @db.Date @map("start_date")
  endDate    DateTime? @db.Date @map("end_date") // Date de fin optionnelle
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relation avec Category (un budget peut être lié à une catégorie)
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Relation avec User (un budget appartient à un utilisateur)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Membership {
  id              String        @id @default(cuid())
  name            String
  amount          Decimal
  billingCycle    BillingCycle  @default(monthly) @map("billing_cycle") // Utilisation de l'Enum BillingCycle
  startDate       DateTime      @db.Date @map("start_date")
  nextBillingDate DateTime      @db.Date @map("next_billing_date")
  description     String?
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relation avec Category (un abonnement peut être lié à une catégorie)
  categoryId      String?       @map("category_id")
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Relation avec User (un abonnement appartient à un utilisateur)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

// --- Enums ---

enum Period {
  monthly
  quarterly
  yearly
}

enum BillingCycle {
  weekly
  monthly
  quarterly
  yearly
}